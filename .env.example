# QoderGateway environment example
# Copy this file to .env or set these variables in your shell.

# Server bind address and port
QODER_HOST=127.0.0.1
QODER_PORT=5050

# Administrator password for the management console.
# This overrides the SQLite-stored gateway token when set.
QODER_ADMIN_PASSWORD=admin

# Optional upstream proxy for outbound Qoder requests.
# Example: http://127.0.0.1:7890
QODER_PROXY=

# Enable or disable public static pages.
# Set to 0 / false / no / off to disable.
QODER_ENABLE_DOCUMENTS=1
QODER_ENABLE_LANDING=1

# Optional PAT auto-imported on first startup when no accounts exist.
QODER_PAT=

# ---- 内置注册机（WebUI / registrar）----
# 邮箱提供方：shiro（默认，自建邮局）或 yyds
MAIL_PROVIDER=shiro
SHIRO_API_KEY=sk_live-xxx
SHIRO_BASE_URL=https://mail.futile.page
SHIRO_DOMAIN_ID=2
SHIRO_MAILBOX_HOURS=24
# yyds 时使用：
# YYDS_API_KEY=AC-xxx
# device-flow 参数覆盖（默认已用 Qoder.app 0.4.3 新版 client_id）
# QODER_DEVICE_CLIENT_ID=732aef47-9cf2-46a2-95fe-4cebb5d0d1fa
# QODER_DEVICE_REDIRECT_URI=qoder-app://
